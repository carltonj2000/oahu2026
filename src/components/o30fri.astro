---
import Mn from "./map-n-name.astro";

interface Props {
  activity?: boolean;
}

const { activity } = Astro.props;
---

{activity ? (
  <div>
    Delivery
    <br />
    Shop
    <br />
    Fireworks
  </div>
) : (
  <div>
    <ul>
      <li>
        <Mn location="Elite Discount Furniture Home Delivery" />
      </li>
      <li>
        <Mn location="Hilton Hawaiian Village Fireworks" />
      </li>
      <li>
        <Mn location="Walmart" />
        <ul class="ml-7">
          <li>Snorkels</li>
          <li>Beach Towels</li>
          <li>Power Bars</li>
          <li>Bananas</li>
          <li>Eco Sunscreen</li>
          <li>Phone Case</li>
          <li>Phone Floating Lanyard</li>
          <li>Dry Bag</li>
        </ul>
      </li>
    </ul>
  </div>
)}
