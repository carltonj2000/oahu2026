---
import Mn from "../components/map-n-name.astro";
interface Props {
  activity?: boolean;
}

const { activity } = Astro.props;
---

{activity ? (
  <div>Hiking</div>
) : (
  <div>
    <ul>
      <li>Hunauma Ridge Trail</li>
      <li>China Wall</li>
      <li>Spitting Cave</li>
      <li>Koko Head Trail</li>
      <li>
        <Mn location="Punchbowl Crater" />
      </li>
    </ul>
  </div>
)}
