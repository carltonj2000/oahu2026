---
import Mn from "../components/map-n-name.astro";
interface Props {
  activity?: boolean;
}

const { activity } = Astro.props;
---

{activity ? (
  <div>Hiking</div>
) : (
  <div>
    <ul>
      <li>
        <Mn location="Pali notches" />
      </li>
      <li>
        <Mn location="Stairway to heaven" />
      </li>
      <li>
        <Mn location="Olomana three notches" />
      </li>
      <li>
        <Mn location="Pillbox" />
      </li>
      <li>
        <Mn location="View of Waikiki and Diamond Head" />
      </li>
    </ul>
  </div>
)}
