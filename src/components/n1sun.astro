---
import Mn from "./map-n-name.astro";

interface Props {
  activity?: boolean;
}

const { activity } = Astro.props;
---

{activity ? (
  <div>
    Beach
    <br />
    Hike
    <br />
    Kayak
  </div>
) : (
  <div>
    <ul>
      <li>
        <Mn location="Kailua Beach" />
      </li>
      <li>
        <Mn location="Pillbox" />
      </li>
      <li>
        <Mn location="Kayak To Mokes - Rent Soon" />
      </li>
    </ul>
  </div>
)}
