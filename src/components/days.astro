---
import o28wed from "./o28wed.astro";
import o29thur from "./o29thur.astro";
import o30fri from "./o30fri.astro";
import o31sat from "./o31sat.astro";
import n1sun from "./n1sun.astro";
import n2mon from "./n2mon.astro";
import n3tue from "./n3tue.astro";
import n4wed from "./n4wed.astro";

const Days = [
	{
		day: new Date(2026, 9, 28),
		content: o28wed,
	},
	{
		day: new Date(2026, 9, 29),
		content: o29thur,
	},
	{
		day: new Date(2026, 9, 30),
		content: o30fri,
	},
	{
		day: new Date(2026, 9, 31),
		content: o31sat,
	},
	{
		day: new Date(2026, 10, 1),
		content: n1sun,
	},
	{
		day: new Date(2026, 11, 2),
		content: n2mon,
	},
	{
		day: new Date(2026, 11, 3),
		content: n3tue,
	},
	{
		day: new Date(2026, 11, 4),
		content: n4wed,
	},
];

const getOrdinalDay = (date: Date): string => {
	const day = date.getDate();
	if (day > 3 && day < 21) return `${day}th`;
	switch (day % 10) {
		case 1:
			return `${day}st`;
		case 2:
			return `${day}nd`;
		case 3:
			return `${day}rd`;
		default:
			return `${day}th`;
	}
};

const shortWeekday = (d: Date): string =>
	d.toLocaleDateString("en-US", { weekday: "short" });
---

<table class="mx-1 mt-3">
	<thead>
		<tr class="bg-fuchsia-300 text-left">
			<th class="px-3 py-2">Date</th>
			<th class="px-3 py-2">Activity</th>
			<th class="px-3 py-2">Details</th>
		</tr>
	</thead>
	<tbody>
		{Days.map((day) => {
			const Activity = day.content;
			return (
				<tr class="text-left odd:bg-fuchsia-200 even:bg-fuchsia-100">
					<td class="px-2 py-1">
						{shortWeekday(day.day)}
						<br />
						{getOrdinalDay(day.day)}
					</td>
					<td class="px-2 py-1">
						<Activity activity={true} />
					</td>
					<td class="px-2 py-1">
						<Activity />
					</td>
				</tr>
			);
		})}
	</tbody>
</table>
